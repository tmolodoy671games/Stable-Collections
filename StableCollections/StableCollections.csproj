<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <AssemblyName>StableCollections</AssemblyName>
    <RootNamespace>StableCollections</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>T.Molodoy.StableCollections</PackageId>
    <Version>0.0.45</Version>
    <Authors>T. Molodoy</Authors>
    <Company>T. Molodoy</Company>
    <Product>Stable Collections</Product>
    <Description>Java-like collections for C#.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/tmolodoy671games/Stable-Collections</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="T.Molodoy.SharpExtensions" Version="0.0.46" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
