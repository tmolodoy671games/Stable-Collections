<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Reactive Stable Collections</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>StableCollections.Reactive.R3</RootNamespace>
    <Nullable>annotations</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>T.Molodoy.StableCollections.Reactive.R3</PackageId>
    <Version>0.0.45</Version>
    <Authors>T. Molodoy</Authors>
    <Company>T. Molodoy</Company>
    <Product>Reactive Stable Collections (R3)</Product>
    <Description>Reactive extension of Stable Collections package (R3).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/tmolodoy671games/Stable-Collections</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <ProjectReference Include="../StableCollections/StableCollections.csproj" />
    <PackageReference Include="R3" Version="1.3.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
